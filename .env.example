# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Dashboard API (Express) ----
PORT=4000
CLIENT_URL=http://localhost:5173
SSE_HEARTBEAT_MS=15000
MAX_SSE_CLIENTS=500

# ---- Datastores ----
MONGODB_URI=mongodb://127.0.0.1:27017/tradesync
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=tradesync

# ---- Mock BSE exchange (separate process) ----
EXCHANGE_PORT=4100
EXCHANGE_URL=http://127.0.0.1:4100
# Development mode: 10 seconds. Assessment simulation: 900000 (15 minutes).
EXCHANGE_PULL_DELAY_MS=10000
EXCHANGE_TRADE_COUNT=5000
# Worker gives up on an exchange operation after this long (must exceed the pull delay).
EXCHANGE_OPERATION_TIMEOUT_MS=1200000
# Per-request timeout for calls from the worker to the exchange (keep well under 30s).
EXCHANGE_HTTP_TIMEOUT_MS=20000

# ---- Background jobs ----
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=2000
WORKER_CONCURRENCY=2
BULK_CHUNK_SIZE=1000
MAX_INVALID_RATIO=0.05
